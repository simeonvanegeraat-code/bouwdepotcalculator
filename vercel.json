{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/calculators.html",
      "destination": "/#gereedschap",
      "permanent": true
    },
    {
      "source": "/maximale-bouwdepot.html",
      "destination": "/leenruimte.html",
      "permanent": true
    },
    {
      "source": "/eigen-geld-bouwdepot.html",
      "destination": "/leenruimte.html",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "plan",
          "value": "haalbaarheid"
        }
      ],
      "destination": "/leenruimte.html",
      "permanent": true
    },
    {
      "source": "/bouwdepot-fouten.html",
      "destination": "/stappenplan.html#fouten",
      "permanent": true
    },
    {
      "source": "/kennisbank.html",
      "destination": "/stappenplan.html",
      "permanent": true
    },
    {
      "source": "/belasting.html",
      "destination": "/hypotheekrenteaftrek-gids.html",
      "permanent": true
    },
    {
      "source": "/adviesgesprek-checklist.html",
      "destination": "/stappenplan.html#adviesgesprek",
      "permanent": true
    }
  ]
}
